{
  "manifest_version": 3,
  "name": "CADFÁCIL — Leitor & Editor DWG/DXF 3D",
  "version": "4.0.0",
  "description": "Leitor e Editor DWG/DXF 3D Serverless de Alta Performance para o seu navegador.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": ["activeTab", "storage"]
}
